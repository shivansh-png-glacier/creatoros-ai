# Server — keep these keys on the server. Never prefix them with VITE_.
MODEL_API_KEY=
MODEL_API_MODEL=muse-spark-1.3
PORT=8787

# Frontend (Vite) — these are bundled into the browser build.
# The Supabase anon key is public by design; never put a service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Backend base URL for the deployed frontend (e.g. your Render service URL).
# Leave empty locally — Vite proxies /api to localhost:8787.
VITE_API_URL=
